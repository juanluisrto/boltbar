{
  "name": "boltbar",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "Lightning-fast global chat bar for AI models on macOS",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:web": "BOLTBAR_WEB_PORT=43127 vite --host 127.0.0.1 --port 43127",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 43127",
    "tauri": "tauri",
    "test": "vitest run",
    "test:rust": "cargo test -p boltbar-core"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "highlight.js": "^11.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  }
}
